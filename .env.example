# Ahoy Indie Media - Example environment file (NO SECRETS)
#
# Copy to .env (or set these in Render → Web Service → Environment).

# Environment
AHOY_ENV=development  # development|production

# Public origin for absolute links in emails (password reset, etc.)
BASE_URL=http://localhost:5000
AHOY_ID_ISSUER=http://127.0.0.1:3005
AHOY_ID_CLIENT_ID=app.ahoy.local-platform
AHOY_ID_REDIRECT_URI=http://127.0.0.1:5002/api/auth/ahoy/callback

# Required in production (Render should generate this)
SECRET_KEY=change-me

# Database (Render injects this automatically from Postgres)
DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# Sessions (Render "Key Value" / Redis / Valkey)
REDIS_URL=redis://red-xxxx:6379

# Email (choose ONE provider path)
# Resend (recommended)
RESEND_API_KEY=
SUPPORT_EMAIL=you@yourdomain.com

# SMTP (alternative)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Google OAuth (Sign In with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional — defaults to BASE_URL + /api/auth/google/callback
GOOGLE_REDIRECT_URI=

# Optional
# Comma-separated list of allowed origins (CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# PostHog analytics (leave blank to disable)
# VITE_* vars are injected into the SPA at build time / runtime
# If VITE_POSTHOG_KEY is blank, the Flask SPA response falls back to POSTHOG_PROJECT_TOKEN.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_DEBUG=false
# Server-side PostHog SDK (same public token as VITE_POSTHOG_KEY)
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# Cookie controls (strings)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
