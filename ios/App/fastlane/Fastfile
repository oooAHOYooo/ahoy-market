default_platform(:ios)

platform :ios do
  desc "Generate screenshots for App Store (Xcode Simulator)"
  lane :screenshots do
    UI.message("📱 iOS Screenshots for App Store Connect")
    UI.message("")
    UI.message("Steps:")
    UI.message("")
    UI.message("1. Start iOS Simulator:")
    UI.message("   open -a Simulator")
    UI.message("")
    UI.message("2. In Simulator, open Safari and go to:")
    UI.message("   http://localhost:5001")
    UI.message("   (or wherever your local dev server runs)")
    UI.message("")
    UI.message("3. Take these 5 screenshots (5.5\", 6.1\", or 6.5\" device):")
    UI.message("")
    UI.message("   📸 Screenshot 1: HOME SCREEN")
    UI.message("      - Main content grid visible")
    UI.message("      - Show music/shows/artists library")
    UI.message("      - File: home.png")
    UI.message("")
    UI.message("   📸 Screenshot 2: NOW PLAYING / PLAYER")
    UI.message("      - Play a song")
    UI.message("      - Show player with album art, title, controls")
    UI.message("      - File: player.png")
    UI.message("")
    UI.message("   📸 Screenshot 3: ARTIST DETAIL")
    UI.message("      - Tap an artist card from home")
    UI.message("      - Show artist bio, top tracks, play all button")
    UI.message("      - File: artist_detail.png")
    UI.message("")
    UI.message("   📸 Screenshot 4: SEARCH / DISCOVERY")
    UI.message("      - Open search or browse artists")
    UI.message("      - Show filtering and discovery UI")
    UI.message("      - File: search.png")
    UI.message("")
    UI.message("   📸 Screenshot 5: PLAYLISTS / SAVED")
    UI.message("      - Navigate to Playlists or Saved/Bookmarks")
    UI.message("      - Show save/bookmark feature in action")
    UI.message("      - File: playlists.png")
    UI.message("")
    UI.message("4. Save screenshots to: ios/App/fastlane/screenshots/")
    UI.message("")
    UI.message("💡 Tips:")
    UI.message("   - Use Simulator Menu: Device → Screenshot")
    UI.message("   - Or press Cmd+S to save screenshot")
    UI.message("   - Size will auto-fit the simulator device")
    UI.message("   - Recommended device: iPhone 15 Pro Max (6.7\") for best detail")
    UI.message("")
    UI.message("5. Upload to App Store Connect:")
    UI.message("   https://appstoreconnect.apple.com")
    UI.message("   → Your App → TestFlight → Screenshots")
  end

  desc "Show XCTest UI Automation template (advanced - optional)"
  lane :setup_ui_tests do
    UI.message("⚙️  Advanced: UI Test Automation Setup")
    UI.message("")
    UI.message("If you want fully automated screenshots later:")
    UI.message("")
    UI.message("1. Create XCTest UI Tests:")
    UI.message("   Xcode → File → New → Test Plan")
    UI.message("   → Select 'UI Test Bundle'")
    UI.message("")
    UI.message("2. Run Fastlane snapshot:")
    UI.message("   fastlane ios snapshot")
    UI.message("")
    UI.message("For now, manual screenshots are faster.")
    UI.message("Set up UI tests after v1.0.0 launches.")
  end
end
